# Copy this file to .env and edit it locally. Do not commit .env.
MODEL_PROVIDER=openai

# Use a model ID that your model-provider account can actually access.
MODEL_NAME=

# Add your model provider API key. Never commit or share the real key.
OPENAI_API_KEY=

# LangSmith tracing is disabled; no LangSmith API key is required.
LANGSMITH_TRACING=false
